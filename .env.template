# RettBot+ Environment Configuration

# =============================================================================
# OPENAI API (REQUIRED)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# BACKUP & STORAGE (Optional - for distributed backup)
# =============================================================================
# ProtonDrive API (zero-knowledge cloud backup)
PROTON_DRIVE_USERNAME=
PROTON_DRIVE_PASSWORD=

# IPFS (distributed backup)
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=http://localhost:8080

# =============================================================================
# DATABASE (Optional - for production)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/rettbot
REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY
# =============================================================================
# Secret key for session encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=your-jwt-secret-here

# Force HTTPS redirect (recommended in production)
FORCE_HTTPS=true

# HSTS Max Age in seconds (default: 31536000 = 1 year)
HSTS_MAX_AGE=31536000

# Include HSTS preload directive (recommended for production)
HSTS_PRELOAD=true

# =============================================================================
# TOR (Optional - for maximum anonymity)
# =============================================================================
TOR_PROXY=socks5://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# =============================================================================
# BLOCKCHAIN TIMESTAMPING (Optional)
# =============================================================================
# OpenTimestamps (free, no API key needed)
OPENTIMESTAMPS_ENABLED=true

# Ethereum (for on-chain timestamps)
ETHEREUM_RPC_URL=
ETHEREUM_PRIVATE_KEY=

# =============================================================================
# DEVELOPMENT
# =============================================================================
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
