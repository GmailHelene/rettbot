# RettBot+ – miljøvariabler
# Kopier til .env lokalt (.env er git-ignorert). Sett de samme i Railway → Variables i produksjon.
# ADVAR: legg ALDRI ekte nøkler inn i git-sporet fil.

# =============================================================================
# AI – ANTHROPIC CLAUDE (PÅKREVD)
# =============================================================================
# Hent nøkkel: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...din-nokkel-her...
# Valgfritt – overstyr modell/effort (standard vist):
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max

# =============================================================================
# SIKKERHET (PÅKREVD I PRODUKSJON)
# =============================================================================
# Generer ÉN gang og lagre trygt. Endres disse, blir alle innlogginger og all
# kryptert saksdata ugyldig/uleselig. Generer med f.eks.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Fernet-nøkkel for kryptering av saksdata. Generer med:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# =============================================================================
# DATABASE (PÅKREVD I PRODUKSJON)
# =============================================================================
# Lokalt kan du utelate denne (bruker da SQLite-fil). I produksjon: bruk Railway
# Postgres. Railway setter DATABASE_URL automatisk når du legger til en Postgres-plugin.
DATABASE_URL=postgresql://user:password@host:5432/rettbot

# =============================================================================
# NETT / CORS
# =============================================================================
# Kommaseparert liste over tillatte origins. Siden backend serverer frontend
# same-origin, trengs dette bare hvis du splitter til eget API-subdomene.
CORS_ORIGINS=https://rettbot.com,https://www.rettbot.com
# Tving HTTPS-redirect bak proxy (Railway). Sett "false" lokalt.
FORCE_HTTPS=true

# =============================================================================
# ØVRIG
# =============================================================================
ENVIRONMENT=production           # "development" lokalt
LOG_LEVEL=INFO
